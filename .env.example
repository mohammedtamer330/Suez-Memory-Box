# Copy to .env.local for local development. Never commit real values.
#
# Storage (production). Attach Upstash Redis (Vercel KV) and Vercel Blob from the Vercel dashboard —
# these are filled in automatically. Locally, if they are empty, the app uses .local-data/ and
# public/dev-uploads/ so the whole admin works offline.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
BLOB_READ_WRITE_TOKEN=

# Admin sign-in. Choose a long, unique password (12+ characters). There is deliberately NO default.
ADMIN_PASSWORD=

# Signs the admin session cookie. REQUIRED in production (24+ random characters), e.g.:
#   openssl rand -base64 32
# Keep it different from ADMIN_PASSWORD.
SESSION_SECRET=

# Your production URL, used for share previews (Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a licensed background track. Leave empty for no music (sound effects are synthesised).
NEXT_PUBLIC_MUSIC_URL=
